# Ejemplo de variables de entorno para SkillBridge backend
# No compartir secretos reales

# PostgreSQL URL (usando psycopg driver). Formato de ejemplo:
# postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Valores ficticios de ejemplo - reemplaza antes de prod
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/skillbridge

# JWT secret key (usa un valor fuerte en producción)
JWT_SECRET_KEY=change-me
# Access token lifetime in seconds (defaults to 900)
JWT_ACCESS_TOKEN_EXPIRES=900

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173

# Rate-limit storage. Use a shared backend in multi-instance production deployments.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_CONNECT_TIMEOUT=2
RATELIMIT_SOCKET_TIMEOUT=2

# Brevo transactional email. Keep disabled until the API key and verified sender exist.
BREVO_EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SkillBridge
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT=10
FRONTEND_URL=http://localhost:5173
