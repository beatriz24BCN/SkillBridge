# Ejemplo de variables de entorno para SkillBridge backend
# No compartir secretos reales

# PostgreSQL URL (usando psycopg driver). Formato de ejemplo:
# postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Valores ficticios de ejemplo - reemplaza antes de prod
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/skillbridge

# JWT secret key (usa un valor fuerte en producción)
JWT_SECRET_KEY=change-me

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173
